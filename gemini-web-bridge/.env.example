# Скопируйте этот файл в .env и заполните значения. .env не коммитьте: там секреты.

# Куки авторизованной сессии gemini.google.com (обязательно).
# Как взять: браузер -> gemini.google.com -> DevTools (F12) -> Application/Storage ->
# Cookies -> https://gemini.google.com -> значения __Secure-1PSID и __Secure-1PSIDTS.
GEMINI_COOKIE_1PSID=
# Для части аккаунтов не нужен, но рекомендуется: без него сессия может быть короткоживущей.
GEMINI_COOKIE_1PSIDTS=

# Модель, которую видит клиент по умолчанию. Имя сопоставляется с моделями вашего аккаунта.
GEMINI_MODEL=gemini-2.5-pro

# Ключ для доступа к прокси. Пусто — без проверки (допустимо только на 127.0.0.1).
# Клиенты передают его как OPENAI_API_KEY / api_key.
BRIDGE_API_KEY=

# Адрес и порт HTTP-сервера. По умолчанию слушаем только локальную машину.
HOST=127.0.0.1
PORT=8000

# Необязательный HTTP(S)/SOCKS-прокси для исходящих запросов к Google, например http://127.0.0.1:7890
GEMINI_PROXY=

# Пауза между запросами к веб-сессии (секунды), с равномерным случайным разбросом (jitter).
GEMINI_REQUEST_DELAY_MIN=1.0
GEMINI_REQUEST_DELAY_MAX=2.5

# Как часто пересоздавать сессию и обновлять токен SNlM0e, в минутах (фактически ±15% случайно).
GEMINI_TOKEN_ROTATE_MINUTES=30

# true — чаты не попадают в историю Gemini в веб-интерфейсе (рекомендуется для прокси).
GEMINI_TEMPORARY_CHAT=true

# Таймаут одного запроса к Gemini, секунды.
GEMINI_TIMEOUT=300

# Каталог для ротированных кук (по умолчанию .state/ рядом с server.py).
# GEMINI_COOKIE_PATH=

# Уровень логов: DEBUG, INFO, WARNING, ERROR. Тексты промптов в логи не пишутся.
LOG_LEVEL=INFO
